# Deployment secrets and network settings
# Copy this file to `.env.deploy.local` before deploying.

PRIVATE_KEY=0xyour_private_key

# Reactive Network deployment
REACTIVE_RPC_URL=https://your-reactive-rpc
REACTIVE_SERVICE_ADDRESS=0xyour_reactive_service_address

# Execution chain deployment
EXECUTION_RPC_URL=https://your-origin-or-destination-rpc
ORIGIN_CHAIN_ID=11155111
DESTINATION_CHAIN_ID=11155111

# Optional tuning
CALLBACK_GAS_LIMIT=900000
DEFAULT_HEARTBEAT_INTERVAL=259200

# After deployment, copy these values into `.env.local` for the frontend.
NEXT_PUBLIC_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REACTIVE_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CALLBACK_SENDER=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ORIGIN_CHAIN_ID=11155111
NEXT_PUBLIC_DESTINATION_CHAIN_ID=11155111
NEXT_PUBLIC_HEARTBEAT_INTERVAL_SECONDS=259200

